# Copy to .env and fill in only the providers you use.
# GOOGLE_API_KEY and GEMINI_API_KEY are accepted aliases; GOOGLE_API_KEY wins.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Local providers (no key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Runtime selection
DIRAI_PROVIDER=gemini
DIRAI_MODEL=gemini-2.5-flash
DIRAI_TEMPERATURE=0.2
DIRAI_TIMEOUT=120
